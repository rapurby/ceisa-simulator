:{$PORT:80} {
    encode gzip

    # Proxy semua /api/* dan /h2h/* ke backend service
    handle /api/* {
        reverse_proxy {$BACKEND_URL}
    }

    handle /h2h/* {
        reverse_proxy {$BACKEND_URL}
    }

    # Semua route lain → React SPA
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
